# Backend API Base URL
# - Chạy trên chính máy host: http://localhost:5000/api
# - Hoặc chỉ định IP LAN của máy host (ví dụ: http://192.168.1.10:5000/api)
# (Frontend đã có cơ chế tự động phân giải hostname sang IP máy host khi thiết bị khác trong cùng Wi-Fi truy cập)
VITE_API_BASE_URL=http://localhost:5000/api
